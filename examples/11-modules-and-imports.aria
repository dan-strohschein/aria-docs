// ============================================================
// File: src/main.aria
// ============================================================
mod main

// Import the whole module (gets all pub items)
use models
// use db.users                         // aspirational

// Import specific symbols
// use std.{log, db}                    // aspirational
use models.user.{User, UserError}

// Import with alias (if names conflict)
// use std.crypto as std_crypto         // aspirational

entry {
    // Use the imported new_user from models (via re-export).
    user := models.new_user(1, "alice", "alice@example.com", "securepass123") catch {
        UserError.InvalidEmail    => { println("Bad email"); return }
        UserError.WeakPassword    => { println("Weak password"); return }
        e                         => { println("Error constructing user"); return }
    }

    println("Created user id={user.id} username={user.username} email={user.email}")

    // Error-path demo: invalid email triggers the UserError.InvalidEmail arm.
    _ := models.new_user(2, "bob", "not-an-email", "anotherpass") catch {
        UserError.InvalidEmail => { println("invalid email rejected as expected"); return }
        e                      => { println("unexpected error"); return }
    }
}
