// Example 11: Modules and Imports
//
// Demonstrates:
//   - Module declaration with `mod`
//   - pub, pub(pkg), and private visibility
//   - `use` imports (qualified and specific)
//   - Re-exports
//   - Module organization conventions
//
// Note: In a real project, each of these modules would be in separate
// files within a package directory. This example shows the declarations
// and usage patterns as they would appear across multiple files.
//
// Aspirational stdlib APIs (std.db, std.crypto hash/verify, std.time.Instant
// in struct fields, std.log) are commented out below — they are part of the
// spec but not yet wired through the self-hosting compiler's stdlib. The
// remaining uncommented code demonstrates the module/import/visibility
// mechanics and runs end-to-end.

// ============================================================
// File: src/models/user.aria
// ============================================================
mod models.user

// use std.{time, crypto}   // aspirational — stdlib wiring incomplete

// Public type — visible outside this module
pub struct User {
    pub id:         i64
    pub username:   str
    pub email:      str
    // pub created_at: time.Instant      // needs std.time
        password_hash: str    // private field — not pub
}

// Package-visible type — only visible within this package
pub(pkg) struct UserCredentials {
    user_id:       i64
    password_hash: str
}

// Private type — only visible within this module
struct PasswordPolicy {
    min_length: i64
    require_upper: bool
}

const DEFAULT_POLICY = PasswordPolicy { min_length: 8, require_upper: true }

// Public function
pub fn new_user(id: i64, username: str, email: str, password: str) -> User!UserError {
    validate_username(username)?
    validate_email(email)?
    hash := hash_password(password)?
    User {
        id,
        username,
        email,
        // created_at: time.now(),       // needs std.time
        password_hash: hash,
    }
}

pub fn check_password(user: User, password: str) -> bool {
    // crypto.verify(password, user.password_hash)   // needs std.crypto
    user.password_hash.len() > 0                     // placeholder
}

// Package-visible — can be used within the package but not exported
pub(pkg) fn get_credentials(user: User) -> UserCredentials {
    UserCredentials { user_id: user.id, password_hash: user.password_hash }
}

// Private — only used in this module
fn validate_username(s: str) -> bool!UserError {
    if s.len() < 3 { return err(UserError.UsernameTooShort) }
    if s.len() > 64 { return err(UserError.UsernameTooLong) }
    true
}

fn validate_email(s: str) -> bool!UserError {
    if !s.contains("@") { return err(UserError.InvalidEmail) }
    true
}

fn hash_password(p: str) -> str!UserError {
    if p.len() < DEFAULT_POLICY.min_length {
        return err(UserError.WeakPassword)
    }
    // crypto.hash_password(p)           // needs std.crypto
    "hashed:" + p                        // placeholder
}

// Public error type
pub type UserError =
    | UsernameTooShort
    | UsernameTooLong
    | InvalidEmail
    | WeakPassword
    | NotFound(i64)

// ============================================================
// File: src/models/mod.aria
// ============================================================
mod models

// Re-export public items from sub-modules
pub use models.user.{User, UserError, new_user, check_password}

// ============================================================
// File: src/db/users.aria  (aspirational — needs std.db)
// ============================================================
