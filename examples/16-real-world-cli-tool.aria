// Example 16: Real-World CLI Tool
//
// Demonstrates:
//   - Argument parsing
//   - Subcommand dispatch via match on variants
//   - File I/O with error handling
//   - Exit codes
//   - Pipeline filters for file-content analysis
//
// Aspirational features (commented out):
//   - Struct field defaults (verbose: bool = false)
//   - Struct update syntax (flags.{ verbose: true })
//   - `enumerate()` iterator method
//   - json.encode on arbitrary structs
//   - @[derive(Json, Debug)] attribute macros
//   - Match guards (`b if b < 1024`)
//   - log.set_level / log.Debug constant
//   - Optional `str?` in sum type payloads

mod main

use std.{fs, os}

// ============================================================
// CLI argument structure
// ============================================================

struct GlobalFlags {
    verbose: bool
    color:   bool
}

fn default_flags() -> GlobalFlags {
    GlobalFlags { verbose: false, color: true }
}

type Subcommand =
    | Count  { path: str, has_pattern: bool, pattern: str }
    | Search { path: str, query: str }
    | Stats  { path: str }
    | Help

// ============================================================
// Domain types
// ============================================================

struct FileStats {
    path:       str
    size_bytes: i64
    line_count: i64
    word_count: i64
    char_count: i64
}

// ============================================================
// Argument parsing
// ============================================================

fn parse_args(args: [str]) -> Subcommand!str {
    if args.len() == 0 {
        return Subcommand.Help
    }

    mut i := 0
    // Skip leading global flags (we don't actually apply them in this trimmed demo)
    while i < args.len() && args[i].starts_with("--") {
        i = i + 1
    }

    if i >= args.len() {
        return Subcommand.Help
    }

    cmd := args[i]
    i = i + 1

    if cmd == "count" {
        if i >= args.len() { return err("count requires a path") }
        p := args[i]
        i = i + 1
        if i < args.len() {
            return Subcommand.Count { path: p, has_pattern: true, pattern: args[i] }
        }
        return Subcommand.Count { path: p, has_pattern: false, pattern: "" }
    }
    if cmd == "search" {
        if i + 1 >= args.len() { return err("search requires <path> and <query>") }
        return Subcommand.Search { path: args[i], query: args[i + 1] }
    }
    if cmd == "stats" {
        if i >= args.len() { return err("stats requires a path") }
        return Subcommand.Stats { path: args[i] }
    }
    if cmd == "help" {
        return Subcommand.Help
    }
    err("Unknown subcommand")
}

// ============================================================
// Commands
// ============================================================

fn cmd_count(path: str, has_pattern: bool, pattern: str) -> bool!str {
    if !fs.exists(path) {
        return err("File not found")
    }

    content := fs.read(path) catch {
        e => return err("Could not read file")
    }
    lines := content.lines()

    if has_pattern {
        // Note: closure capture of str isn't wired yet — use a plain for-loop.
        mut matching := 0
        for line in lines {
            if line.contains(pattern) { matching = matching + 1 }
        }
        println("{matching} lines matching '{pattern}' in {path}")
    } else {
        println("{lines.len()} lines in {path}")
    }
    true
}

fn cmd_search(path: str, query: str) -> bool!str {
    if !fs.exists(path) {
        return err("File not found")
    }

    content := fs.read(path) catch {
        e => return err("Could not read file")
    }

    lines := content.lines()
    mut line_no := 1
    mut match_count := 0
    for line in lines {
        if line.contains(query) {
            println("{path}:{line_no}: {line.trim()}")
            match_count = match_count + 1
        }
        line_no = line_no + 1
    }

    if match_count == 0 {
        println("No matches found for '{query}'")
    } else {
        println("{match_count} match(es) found")
    }
    true
}

fn cmd_stats(path: str) -> bool!str {
    if !fs.exists(path) {
        return err("File not found")
    }

    content := fs.read(path) catch {
        e => return err("Could not read file")
    }

    lines := content.lines()
    words := content.split_whitespace()
    chars := content.chars()

    stats := FileStats {
        path:       path,
        size_bytes: content.len(),
        line_count: lines.len(),
        word_count: words.len(),
        char_count: chars.len(),
    }

    println("File:  {stats.path}")
    println("Size:  {format_bytes(stats.size_bytes)} bytes")
    println("Lines: {stats.line_count}")
    println("Words: {stats.word_count}")
    println("Chars: {stats.char_count}")
    true
}

fn cmd_help() {
    println("aria-analyze — File analysis tool written in Aria")
    println("")
    println("USAGE:")
    println("  aria-analyze [FLAGS] <COMMAND> [OPTIONS]")
    println("")
    println("FLAGS:")
    println("  --verbose       Enable verbose output")
    println("  --no-color      Disable colored output")
    println("")
    println("COMMANDS:")
    println("  count <path> [pattern]    Count lines (optionally matching pattern)")
    println("  search <path> <query>     Search for text in a file")
    println("  stats <path>              Show file statistics")
    println("  help                      Show this help message")
}

// ============================================================
// Utilities
// ============================================================

fn format_bytes(n: i64) -> str {
    // Match guards (`b if b < 1024`) aren't implemented yet; use if/else chain.
    if n < 1024 { return "{n}" }
    if n < 1024 * 1024 { return "{n / 1024} K" }
    if n < 1024 * 1024 * 1024 { return "{n / (1024 * 1024)} M" }
    "{n / (1024 * 1024 * 1024)} G"
}

// ============================================================
// Entry point
// ============================================================

entry {
    // os.args() returns [sentinel, progname, arg1, arg2, ...]; skip 2 to get user args
    all_args := os.args()
    mut user_args: [str] = []
    mut ai := 2
    while ai < all_args.len() {
        user_args = user_args.append(all_args[ai])
        ai = ai + 1
    }

    subcommand := parse_args(user_args) catch {
        e => {
            println("Error: {e}")
            println("Run with 'help' for usage.")
            exit(1)
        }
    }

    success := match subcommand {
        Help                                   => { cmd_help(); true }
        Count { path, has_pattern, pattern }   => cmd_count(path, has_pattern, pattern) catch { e => { println("Error: {e}"); false } }
        Search { path, query }                 => cmd_search(path, query) catch { e => { println("Error: {e}"); false } }
        Stats { path }                         => cmd_stats(path) catch { e => { println("Error: {e}"); false } }
    }

    if !success { exit(1) }
}
