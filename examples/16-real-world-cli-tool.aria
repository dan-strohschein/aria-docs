// Example 16: Real-World CLI Tool
//
// Demonstrates:
//   - Argument parsing with std.flag
//   - Subcommand dispatch
//   - File I/O with error handling
//   - Formatted output (tables, colors)
//   - Pipeline processing
//   - Exit codes
//   - Environment variable access

mod main

use std.{fs, flag, log, json, os, time}

// ============================================================
// CLI argument structure
// ============================================================

struct GlobalFlags {
    verbose: bool = false
    output:  str  = "text"     // "text" | "json"
    color:   bool = true
}

type Subcommand =
    | Count  { path: str, pattern: str? }
    | Search { path: str, query: str, recursive: bool }
    | Stats  { path: str }
    | Help

// ============================================================
// Domain types
// ============================================================

struct FileStats {
    path:       str
    size_bytes: i64
    line_count: i64
    word_count: i64
    char_count: i64
}

@[derive(Json, Debug)]
struct SearchResult {
    file:    str
    line:    i64
    content: str
}

// ============================================================
// Argument parsing
// ============================================================

fn parse_args(args: [str]) -> (GlobalFlags, Subcommand)!str {
    if args.len() == 0 {
        return (GlobalFlags {}, Subcommand.Help)
    }

    mut flags := GlobalFlags {}
    mut i     := 0

    // Parse global flags
    while i < args.len() && args[i].starts_with("--") {
        match args[i] {
            "--verbose"      => { flags = flags.{ verbose: true };       i = i + 1 }
            "--no-color"     => { flags = flags.{ color: false };        i = i + 1 }
            "--output=json"  => { flags = flags.{ output: "json" };      i = i + 1 }
            "--output=text"  => { flags = flags.{ output: "text" };      i = i + 1 }
            unknown          => return err("Unknown flag: {unknown}")
        }
    }

    if i >= args.len() {
        return (flags, Subcommand.Help)
    }

    subcommand := match args[i] {
        "count" => {
            i = i + 1
            if i >= args.len() {
                return err("count requires a path argument")
            }
            path    := args[i]; i = i + 1
            pattern := if i < args.len() { Some(args[i]) } else { None }
            Subcommand.Count { path, pattern }
        }
        "search" => {
            i = i + 1
            mut recursive := false
            if i < args.len() && args[i] == "--recursive" {
                recursive = true
                i = i + 1
            }
            if i + 1 >= args.len() {
                return err("search requires <path> and <query> arguments")
            }
            path  := args[i]; i = i + 1
            query := args[i]
            Subcommand.Search { path, query, recursive }
        }
        "stats" => {
            i = i + 1
            if i >= args.len() {
                return err("stats requires a path argument")
            }
            Subcommand.Stats { path: args[i] }
        }
        "help" | "--help" | "-h" => Subcommand.Help
        unknown => return err("Unknown subcommand: {unknown}. Run with 'help' for usage.")
    }

    (flags, subcommand)
}

// ============================================================
// Commands
// ============================================================

fn cmd_count(flags: GlobalFlags, path: str, pattern: str?) -> bool!str {
    if !fs.exists(path) {
        return err("File not found: {path}")
    }

    content := fs.read(path) catch {
        e => return err("Could not read file: {e}")
    }
    lines := content.lines()

    count := match pattern {
        Some(p) => lines |> filter(fn(l) => l.contains(p)) |> count()
        None    => lines.len()
    }

    if flags.output == "json" {
        result := json.encode({ "file": path, "count": count, "pattern": pattern }) catch {
            e => return err("Encoding error: {e}")
        }
        println(result)
    } else {
        match pattern {
            Some(p) => println("{count} lines matching '{p}' in {path}")
            None    => println("{count} lines in {path}")
        }
    }
    true
}

fn cmd_search(flags: GlobalFlags, path: str, query: str, recursive: bool) -> bool!str {
    files := if recursive {
        fs.walk(path)
            |> filter(fn(f) => f.ends_with(".aria") || f.ends_with(".txt") || f.ends_with(".md"))
            |> collect()
    } else {
        [path]
    }

    mut results: [SearchResult] = []

    for file in files {
        content := fs.read(file) catch {
            e => {
                if flags.verbose { log.warn("Skipping {file}: {e}") }
                continue
            }
        }
        for (i, line) in content.lines().enumerate() {
            if line.contains(query) {
                results = results.append(SearchResult {
                    file:    file
                    line:    i + 1
                    content: line.trim()
                })
            }
        }
    }

    if results.len() == 0 {
        println("No matches found for '{query}'")
        return true
    }

    if flags.output == "json" {
        output := json.encode(results) catch {
            e => return err("Encoding error: {e}")
        }
        println(output)
    } else {
        for r in results {
            if flags.color {
                highlighted := r.content.replace(query, "\x1b[33m{query}\x1b[0m")
                println("{r.file}:{r.line}: {highlighted}")
            } else {
                println("{r.file}:{r.line}: {r.content}")
            }
        }
        println("\n{results.len()} match(es) found")
    }
    true
}

fn cmd_stats(flags: GlobalFlags, path: str) -> bool!str {
    if !fs.exists(path) {
        return err("File not found: {path}")
    }

    content := fs.read(path) catch {
        e => return err("Could not read file: {e}")
    }
    meta := fs.metadata(path) catch {
        e => return err("Could not read metadata: {e}")
    }

    lines := content.lines()
    words := content.split_whitespace()
    chars := content.chars()

    stats := FileStats {
        path:       path
        size_bytes: meta.size
        line_count: lines.len()
        word_count: words.len()
        char_count: chars.len()
    }

    if flags.output == "json" {
        output := json.encode(stats) catch {
            e => return err("Encoding error: {e}")
        }
        println(output)
    } else {
        println("File:  {stats.path}")
        println("Size:  {format_bytes(stats.size_bytes)}")
        println("Lines: {stats.line_count}")
        println("Words: {stats.word_count}")
        println("Chars: {stats.char_count}")
    }
    true
}

fn cmd_help() {
    println("aria-analyze — File analysis tool written in Aria")
    println("")
    println("USAGE:")
    println("  aria-analyze [FLAGS] <COMMAND> [OPTIONS]")
    println("")
    println("FLAGS:")
    println("  --verbose       Enable verbose output")
    println("  --no-color      Disable colored output")
    println("  --output=json   Output results as JSON")
    println("")
    println("COMMANDS:")
    println("  count <path> [pattern]             Count lines (optionally matching pattern)")
    println("  search [--recursive] <path> <q>   Search for text in file(s)")
    println("  stats <path>                       Show file statistics")
    println("  help                               Show this help message")
    println("")
    println("EXAMPLES:")
    println("  aria-analyze count src/main.aria")
    println("  aria-analyze count src/main.aria fn")
    println("  aria-analyze search --recursive src/ TODO")
    println("  aria-analyze --output=json stats README.md")
}

// ============================================================
// Utilities
// ============================================================

fn format_bytes(n: i64) -> str {
    match n {
        b if b < 1_024                   => "{b} B"
        b if b < 1_024 * 1_024           => "{b / 1_024} KB"
        b if b < 1_024 * 1_024 * 1_024   => "{b / (1_024 * 1_024)} MB"
        b                                => "{b / (1_024 * 1_024 * 1_024)} GB"
    }
}

// ============================================================
// Entry point
// ============================================================

entry {
    args := os.args().skip(1).collect()    // skip the program name

    (flags, subcommand) := parse_args(args) catch {
        e => {
            println("Error: {e}")
            println("Run with 'help' for usage.")
            exit(1)
        }
    }

    if flags.verbose {
        log.set_level(log.Debug)
    }

    success := match subcommand {
        Help               => { cmd_help(); true }
        Count { path, pattern }          => cmd_count(flags, path, pattern)
        Search { path, query, recursive } => cmd_search(flags, path, query, recursive)
        Stats { path }                   => cmd_stats(flags, path)
    } catch {
        e => {
            println("Error: {e}")
            false
        }
    }

    if !success { exit(1) }
}
